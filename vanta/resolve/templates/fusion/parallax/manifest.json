{
  "name": "parallax",
  "version": "1.0.0",
  "category": "effect",
  "description": "Slow push and drift (Ken Burns / 2.5D parallax) for stills or static shots.",
  "file": "template.comp",
  "params": [
    {
      "name": "in_frame",
      "type": "int",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 100000,
      "description": "first frame (clip-relative)"
    },
    {
      "name": "out_frame",
      "type": "int",
      "required": false,
      "default": null,
      "min": 1,
      "max": 100000,
      "description": "last frame (clip-relative)"
    },
    {
      "name": "anim_frames",
      "type": "int",
      "required": false,
      "default": 8,
      "min": 1,
      "max": 60
    },
    {
      "name": "pan_x0",
      "type": "number",
      "required": false,
      "default": 0.5,
      "min": 0.3,
      "max": 0.7
    },
    {
      "name": "pan_x1",
      "type": "number",
      "required": false,
      "default": 0.52,
      "min": 0.3,
      "max": 0.7
    },
    {
      "name": "pan_y0",
      "type": "number",
      "required": false,
      "default": 0.5,
      "min": 0.3,
      "max": 0.7
    },
    {
      "name": "pan_y1",
      "type": "number",
      "required": false,
      "default": 0.5,
      "min": 0.3,
      "max": 0.7
    },
    {
      "name": "zoom_0",
      "type": "number",
      "required": false,
      "default": 1.0,
      "min": 0.8,
      "max": 2.0
    },
    {
      "name": "zoom_1",
      "type": "number",
      "required": false,
      "default": 1.08,
      "min": 0.8,
      "max": 2.0
    }
  ],
  "requires_matte": false,
  "spatial_reason_required": false,
  "route": "clip_comp",
  "gate": "G3",
  "fallback": null,
  "tags": [
    "motion",
    "stills"
  ]
}