{
  "name": "flash_transition",
  "version": "1.0.0",
  "category": "transition",
  "description": "Flash: brightness spikes into the cut and decays after it (punctuate a beat or drop).",
  "file": "template.comp",
  "params": [
    {
      "name": "in_frame",
      "type": "int",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 100000,
      "description": "first frame (clip-relative)"
    },
    {
      "name": "out_frame",
      "type": "int",
      "required": false,
      "default": null,
      "min": 1,
      "max": 100000,
      "description": "last frame (clip-relative)"
    },
    {
      "name": "anim_frames",
      "type": "int",
      "required": false,
      "default": 8,
      "min": 1,
      "max": 60
    },
    {
      "name": "edge",
      "type": "enum",
      "required": false,
      "default": "tail",
      "choices": [
        "tail",
        "head"
      ]
    },
    {
      "name": "gain_a",
      "type": "number",
      "required": false,
      "default": 1.0,
      "min": 0.2,
      "max": 6
    },
    {
      "name": "gain_b",
      "type": "number",
      "required": false,
      "default": 3.0,
      "min": 0.2,
      "max": 6
    }
  ],
  "requires_matte": false,
  "spatial_reason_required": false,
  "route": "transition_halves",
  "gate": "G12",
  "fallback": "cross_dissolve",
  "tags": [
    "transition"
  ]
}