{
  "name": "camera_shake",
  "version": "1.0.0",
  "category": "effect",
  "description": "Impact shake with deterministic, seeded keyframes (overscanned, no black edges).",
  "file": "template.comp",
  "params": [
    {
      "name": "in_frame",
      "type": "int",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 100000,
      "description": "first frame (clip-relative)"
    },
    {
      "name": "out_frame",
      "type": "int",
      "required": false,
      "default": null,
      "min": 1,
      "max": 100000,
      "description": "last frame (clip-relative)"
    },
    {
      "name": "anim_frames",
      "type": "int",
      "required": false,
      "default": 8,
      "min": 1,
      "max": 60
    },
    {
      "name": "overscan",
      "type": "number",
      "required": false,
      "default": 1.06,
      "min": 1.0,
      "max": 1.3
    }
  ],
  "requires_matte": false,
  "spatial_reason_required": false,
  "route": "clip_comp",
  "gate": "G3",
  "fallback": null,
  "tags": [
    "motion",
    "impact"
  ]
}