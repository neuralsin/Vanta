{
  "name": "zoom_punch",
  "version": "1.0.0",
  "category": "transition",
  "description": "Zoom punch: outgoing clip scales up with radial-ish blur into the cut, incoming settles from oversize.",
  "file": "template.comp",
  "params": [
    {
      "name": "in_frame",
      "type": "int",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 100000,
      "description": "first frame (clip-relative)"
    },
    {
      "name": "out_frame",
      "type": "int",
      "required": false,
      "default": null,
      "min": 1,
      "max": 100000,
      "description": "last frame (clip-relative)"
    },
    {
      "name": "anim_frames",
      "type": "int",
      "required": false,
      "default": 8,
      "min": 1,
      "max": 60
    },
    {
      "name": "edge",
      "type": "enum",
      "required": false,
      "default": "tail",
      "choices": [
        "tail",
        "head"
      ]
    },
    {
      "name": "size_a",
      "type": "number",
      "required": false,
      "default": 1.0,
      "min": 0.5,
      "max": 3
    },
    {
      "name": "size_b",
      "type": "number",
      "required": false,
      "default": 1.35,
      "min": 0.5,
      "max": 3
    },
    {
      "name": "blur_a",
      "type": "number",
      "required": false,
      "default": 0.0,
      "min": 0,
      "max": 0.5
    },
    {
      "name": "blur_b",
      "type": "number",
      "required": false,
      "default": 0.12,
      "min": 0,
      "max": 0.5
    }
  ],
  "requires_matte": false,
  "spatial_reason_required": false,
  "route": "transition_halves",
  "gate": "G12",
  "fallback": "cross_dissolve",
  "tags": [
    "transition"
  ]
}